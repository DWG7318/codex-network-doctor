{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cnd/schemas/network-change-plan.schema.json",
  "title": "LCnd Network Change Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "state", "tool_version", "platform", "architecture", "profile_id", "node_id", "node_direction", "default_outbound", "tunnel_outbound", "decisions", "protected_decisions", "candidate", "candidate_sha256", "simulation_only"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "plan_id": {"$ref": "#/$defs/sha256"},
    "state": {"const": "PLAN_READY"},
    "tool_version": {"type": "string", "minLength": 1, "maxLength": 32},
    "platform": {"const": "ubuntu-24.04"},
    "architecture": {"const": "amd64"},
    "profile_id": {"$ref": "#/$defs/id"},
    "node_id": {"$ref": "#/$defs/id"},
    "node_direction": {"enum": ["china_egress", "global_egress"]},
    "default_outbound": {"enum": ["direct", "lcnd-tunnel"]},
    "tunnel_outbound": {"enum": ["direct", "lcnd-tunnel"]},
    "decisions": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "#/$defs/decision"}},
    "protected_decisions": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "#/$defs/decision"}},
    "candidate": {"$ref": "#/$defs/candidate"},
    "candidate_sha256": {"$ref": "#/$defs/sha256"},
    "simulation_only": {"const": true}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["domain", "domain_suffix", "ip_cidr"]},
        "value": {"type": "string", "minLength": 1, "maxLength": 253},
        "protocol": {"enum": ["tcp", "udp"]},
        "ports": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 65535}}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_set_id", "rule", "outbound"],
      "properties": {
        "target_set_id": {"$ref": "#/$defs/id"},
        "rule": {"$ref": "#/$defs/target"},
        "outbound": {"enum": ["direct", "lcnd-tunnel"]}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "engine_version", "secret_ref"],
      "properties": {
        "engine": {"const": "sing-box"},
        "engine_version": {"const": "1.13.12"},
        "secret_ref": {"type": "string", "pattern": "^lcnd-secret://[a-z0-9][a-z0-9/_-]{1,127}$"}
      }
    }
  }
}
