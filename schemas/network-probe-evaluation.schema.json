{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cnd/schemas/network-probe-evaluation.schema.json",
  "title": "LCnd offline probe evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "workload_id", "evidence_mode", "status", "codes", "summary", "production_healthy"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "plan_id": {"$ref": "#/$defs/id"},
    "workload_id": {"$ref": "#/$defs/id"},
    "evidence_mode": {"const": "synthetic"},
    "status": {"enum": ["SYNTHETIC_PASS", "SYNTHETIC_FAIL", "INSUFFICIENT_EVIDENCE"]},
    "codes": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z0-9_]+$", "maxLength": 64}},
    "summary": {"type": "string", "minLength": 1, "maxLength": 512},
    "production_healthy": {"const": false}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"}}
}
