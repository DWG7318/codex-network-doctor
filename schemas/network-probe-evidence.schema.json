{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cnd/schemas/network-probe-evidence.schema.json",
  "title": "LCnd synthetic probe evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "workload_id", "evidence_mode", "results"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "plan_id": {"$ref": "#/$defs/id"},
    "workload_id": {"$ref": "#/$defs/id"},
    "evidence_mode": {"const": "synthetic"},
    "results": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["probe_id", "class", "route", "attempted", "succeeded", "status_class", "endpoint_identity"], "properties": {"probe_id": {"$ref": "#/$defs/id"}, "class": {"$ref": "#/$defs/probe_class"}, "route": {"$ref": "#/$defs/route"}, "attempted": {"type": "integer", "minimum": 0, "maximum": 10}, "succeeded": {"type": "integer", "minimum": 0, "maximum": 10}, "status_class": {"enum": ["success", "failure", "timeout"]}, "endpoint_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
    "probe_class": {"enum": ["direct_control_probe", "direct_application_probe", "egress_continuity_probe", "egress_application_probe", "protected_target_probe", "rollback_probe", "secret_leak_probe"]},
    "route": {"type": "object", "additionalProperties": false, "required": ["id", "class"], "properties": {"id": {"enum": ["direct", "lcnd-egress-cn", "lcnd-egress-global"]}, "class": {"enum": ["direct", "china_egress", "global_egress"]}}}
  }
}
