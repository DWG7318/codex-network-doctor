{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cnd/schemas/network-protected-targets.schema.json",
  "title": "LCnd permanent protected platform targets",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_set_id", "evidence_mode", "targets"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "target_set_id": {"const": "protected-platform"},
    "evidence_mode": {"const": "synthetic"},
    "targets": {"type": "array", "minItems": 17, "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["id", "kind"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"}, "kind": {"enum": ["tcp_listener", "udp_listener", "read_only_fingerprint"]}, "address": {"type": "string", "maxLength": 45}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}, "protocol": {"enum": ["tcp", "udp"]}}}}
  }
}
