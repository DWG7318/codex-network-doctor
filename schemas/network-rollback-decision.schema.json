{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cnd/schemas/network-rollback-decision.schema.json",
  "title": "LCnd scoped rollback decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "decision", "scope", "triggers", "evidence_mode", "production_authorized", "summary"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "plan_id": {"$ref": "#/$defs/id"},
    "decision": {"enum": ["APPLY_ELIGIBLE", "ROLLBACK_REQUIRED", "FAIL_CLOSED"]},
    "scope": {"type": "object", "additionalProperties": false, "required": ["workload_id", "attachment_id"], "properties": {"workload_id": {"$ref": "#/$defs/id"}, "attachment_id": {"$ref": "#/$defs/id"}}},
    "triggers": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z0-9_]+$", "maxLength": 64}},
    "evidence_mode": {"const": "synthetic"},
    "production_authorized": {"const": false},
    "summary": {"type": "string", "minLength": 1, "maxLength": 512}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"}}
}
