{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cnd/schemas/network-secret-ref.schema.json",
  "title": "LCnd non-secret reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ref", "owner", "consumer", "material_class", "rotation_policy", "allowed_outputs", "forbidden_outputs"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "ref": {"type": "string", "pattern": "^lcnd-secret://[a-z0-9][a-z0-9/_-]{1,127}$"},
    "owner": {"const": "LCSP"},
    "consumer": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
    "material_class": {"enum": ["engine_runtime_config", "consumer_credential"]},
    "rotation_policy": {"const": "owner_managed"},
    "allowed_outputs": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["presence_status", "redacted_digest"]}},
    "forbidden_outputs": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"enum": ["value", "url", "password", "token", "subscription", "private_key"]}}
  }
}
