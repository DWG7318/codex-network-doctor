{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cnd/schemas/network-target-set.schema.json",
  "title": "LCnd Network Target Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_set_id", "revision", "purpose", "targets"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "target_set_id": {"$ref": "#/$defs/id"},
    "revision": {"type": "integer", "minimum": 1},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 256},
    "targets": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "#/$defs/target"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["domain", "domain_suffix", "ip_cidr"]},
        "value": {"type": "string", "minLength": 1, "maxLength": 253},
        "protocol": {"enum": ["tcp", "udp"]},
        "ports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 65535,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1, "maximum": 65535}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"enum": ["domain", "domain_suffix"]}}},
          "then": {"properties": {"value": {"pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*$"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "ip_cidr"}}},
          "then": {"properties": {"value": {"pattern": "^[0-9A-Fa-f:.]+/[0-9]{1,3}$"}}}
        }
      ]
    }
  }
}
