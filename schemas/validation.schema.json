{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cnd/schemas/validation.schema.json",
  "title": "Codex Network Doctor Validation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "valid",
    "checked_files",
    "issues"
  ],
  "properties": {
    "valid": {
      "type": "boolean"
    },
    "checked_files": {
      "type": "integer",
      "minimum": 0
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
